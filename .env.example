# PawPal AI configuration - copy to .env and fill in for live-model mode.
# Demo mode (the default) needs NO configuration and NO API key.

# LLM provider settings (used by --live commands and Streamlit live mode)
# Supported providers: gemini (default) or anthropic
PAWPAL_LLM_PROVIDER=gemini
# Model id for the chosen provider, e.g. gemini-3.5-flash or claude-opus-5
PAWPAL_LLM_MODEL=gemini-3.5-flash
PAWPAL_API_KEY=replace-me

# Set to true to make the Streamlit app use the live model. The CLI and
# evaluator use their explicit --live flags instead.
PAWPAL_USE_LIVE_MODEL=false

# Set to false to disable JSONL operational logging in logs/
PAWPAL_LOGGING_ENABLED=true
